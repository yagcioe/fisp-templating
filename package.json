{
  "name": "template-engine-comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p .",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src', 'dist', { recursive: true, filter: (f) => !/\\.tsx?$/.test(f) })\""
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@kitajs/html": "^4.2.13",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
